{
  "family": "task-frontend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "taskRoleArn": "$LAB_ROLE_ARN",
  "executionRoleArn": "$LAB_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "$ECR_REPO_URL_FRONTEND:latest",
      "portMappings": [
        { "name": "frontend-80", "containerPort": 80, "protocol": "tcp" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/task-frontend",
          "awslogs-region": "$AWS_REGION",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
